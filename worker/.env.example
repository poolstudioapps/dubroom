# ── Supabase ────────────────────────────────────────────────────────────
# La cle service contourne RLS. Elle ne quitte jamais cette machine :
# ni Vercel, ni le navigateur, ni une variable NEXT_PUBLIC_* (PRD §14).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── ElevenLabs ──────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Separation de sources (PRD §5.4, lot 0) ─────────────────────────────
# demucs | elevenlabs — bascule d'une implementation a l'autre sans
# toucher au reste du pipeline.
SEPARATION_MODE=demucs

# ── Identite et espace de travail ───────────────────────────────────────
WORKER_ID=
WORK_DIR=./work

# ── Binaires — chemins relatifs, resolus via path.resolve() ─────────────
FFMPEG_PATH=./bin/ffmpeg.exe
FFPROBE_PATH=./bin/ffprobe.exe
YTDLP_PATH=./bin/yt-dlp.exe

# ── Demucs ──────────────────────────────────────────────────────────────
PYTHON_PATH=python
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu
DEMUCS_JOBS=2
DEMUCS_SEGMENT=7

# ── Garde-fous ──────────────────────────────────────────────────────────
MAX_VIDEO_DURATION_MS=600000
MAX_UPLOAD_BYTES=2147483648
JOB_POLL_INTERVAL_MS=2000
JOB_MAX_ATTEMPTS=3
JOB_STALE_MINUTES=10
MAX_CONCURRENT_JOBS=1
WORK_RETENTION_DAYS=7
