# ---- Front (Vercel) ----------------------------------------------------
# Ces deux valeurs sont publiques par nature : elles partent dans le
# navigateur. La cle service Supabase et la cle ElevenLabs n'ont rien a
# faire ici, elles ne vivent que sur le worker (PRD §14).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# L'adresse publique du site, sans barre finale : elle sert aux liens
# absolus (partage, plan du site). Sur Vercel, l'adresse de production est
# prise par defaut ; a renseigner des qu'un domaine a nous existe.
NEXT_PUBLIC_SITE_URL=

# Le captcha de la connexion (Cloudflare Turnstile). Vide : pas de captcha.
# La cle secrete correspondante se donne a Supabase, dans Authentication →
# Attack protection ; les deux vont ensemble.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
